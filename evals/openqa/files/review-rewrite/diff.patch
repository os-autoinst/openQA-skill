-    my $os_like_name = script_output("$go_to_target grep -e \"^$line\\b\" ${os_release_file} | cut -d'\"' -f2");
-    return ($os_like_name =~ /$distri_name/i);
+    # /etc/os-release does not change during a test run, so cache the result
