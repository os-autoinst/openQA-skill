// opencode 2.x: put these entries at the end of the "permissions" array in
// ~/.config/opencode/opencode.jsonc, below whatever is there, and leave out the 1.x block in
// ../opencode/. opencode tries the entries in order and the final match decides; its own
// allow-everything rule sits first, so nothing here allows "*", which would cancel every
// deny above it.
{
  "permissions": [
    // Directories outside the project, absolute or from ~. The read, grep and glob tools are
    // checked against them, and so is a shell call that changes into one.
    { "action": "external_directory", "resource": "~/.config/openqa/*", "effect": "deny" },
    { "action": "external_directory", "resource": "/etc/openqa/*", "effect": "deny" },
    { "action": "external_directory", "resource": "/usr/etc/openqa/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.config/gh/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.config/osc/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.config/tea/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.local/state/osc/*", "effect": "deny" },

    // A read is checked against the path relative to the session's directory or worktree when
    // the file lies inside them, else against the absolute path, ~ expanded and symlinks not
    // followed: each pattern starts with "*" to fit both forms. opencode's .env rules only ask.
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.config/openqa/*", "effect": "deny" },
    { "action": "read", "resource": "*etc/openqa/*", "effect": "deny" },
    { "action": "read", "resource": "*.config/gh/hosts.yml", "effect": "deny" },
    { "action": "read", "resource": "*.config/osc/*", "effect": "deny" },
    { "action": "read", "resource": "*.oscrc", "effect": "deny" },
    { "action": "read", "resource": "*.config/tea/*", "effect": "deny" },
    { "action": "read", "resource": "*.netrc", "effect": "deny" },
    { "action": "read", "resource": "*.git-credentials", "effect": "deny" },
    { "action": "read", "resource": "*.local/state/osc/cookiejar", "effect": "deny" },

    // Compared with every simple command opencode cuts out of a shell call, as written, before
    // expansion. A pattern ending in " *" also fits the command given with no arguments.
    { "action": "shell", "resource": "*.config/openqa*", "effect": "deny" },
    { "action": "shell", "resource": "*/etc/openqa*", "effect": "deny" },
    { "action": "shell", "resource": "*gh/hosts.yml*", "effect": "deny" },
    { "action": "shell", "resource": "*.config/gh/*", "effect": "deny" },
    { "action": "shell", "resource": "*.config/gh *", "effect": "deny" },
    { "action": "shell", "resource": "*.config/osc*", "effect": "deny" },
    { "action": "shell", "resource": "*oscrc*", "effect": "deny" },
    { "action": "shell", "resource": "*.config/tea*", "effect": "deny" },
    { "action": "shell", "resource": "*.netrc*", "effect": "deny" },
    { "action": "shell", "resource": "*.git-credentials*", "effect": "deny" },
    { "action": "shell", "resource": "*osc/cookiejar*", "effect": "deny" },
    { "action": "shell", "resource": "*gh auth token*", "effect": "deny" },
    { "action": "shell", "resource": "*gh auth status*", "effect": "deny" },
    { "action": "shell", "resource": "*gh auth git-credential*", "effect": "deny" },
    { "action": "shell", "resource": "*-H*uthorization*", "effect": "deny" },
    { "action": "shell", "resource": "*-*H *uthorization*", "effect": "deny" },
    { "action": "shell", "resource": "*--header*uthorization*", "effect": "deny" },
    { "action": "shell", "resource": "*openqa-cli *uthorization*", "effect": "deny" },
    { "action": "shell", "resource": "*--apikey*", "effect": "deny" },
    { "action": "shell", "resource": "*--apisecret*", "effect": "deny" },
    { "action": "shell", "resource": "*://*:*@*", "effect": "deny" },
    { "action": "shell", "resource": "*MOJO_CLIENT_DEBUG*", "effect": "deny" },
    { "action": "shell", "resource": "git-obs *login list*", "effect": "deny" },
    { "action": "shell", "resource": "git obs *login list*", "effect": "deny" },
    { "action": "shell", "resource": "*gitcredentials-helper*", "effect": "deny" },
    { "action": "shell", "resource": "*login helper*", "effect": "deny" },
    { "action": "shell", "resource": "*logins helper*", "effect": "deny" },
    { "action": "shell", "resource": "*login git-credential*", "effect": "deny" },
    { "action": "shell", "resource": "*logins git-credential*", "effect": "deny" },
    { "action": "shell", "resource": "tea login e*", "effect": "deny" },
    { "action": "shell", "resource": "tea logins e*", "effect": "deny" },
    { "action": "shell", "resource": "osc *--dump-*", "effect": "deny" },
    { "action": "shell", "resource": "*--http-d*", "effect": "deny" },
    { "action": "shell", "resource": "*--http-f*", "effect": "deny" },
    { "action": "shell", "resource": "*http_debug*", "effect": "deny" },
    { "action": "shell", "resource": "*http_full_debug*", "effect": "deny" },
    { "action": "shell", "resource": "*HTTP_DEBUG*", "effect": "deny" },
    { "action": "shell", "resource": "*HTTP_FULL_DEBUG*", "effect": "deny" },
    { "action": "shell", "resource": "osc -H*", "effect": "deny" },
    { "action": "shell", "resource": "osc * -H*", "effect": "deny" },
    { "action": "shell", "resource": "osc -*H *", "effect": "deny" },
    { "action": "shell", "resource": "osc token*", "effect": "deny" },
    { "action": "shell", "resource": "osc *api*/person/*/token*", "effect": "deny" },
    { "action": "shell", "resource": "osc config * pass*", "effect": "deny" },
    { "action": "shell", "resource": "*credential fill*", "effect": "deny" },
    { "action": "shell", "resource": "*credential-* get*", "effect": "deny" },
    { "action": "shell", "resource": "*secret-tool lookup*", "effect": "deny" },
    { "action": "shell", "resource": "*secret-tool search*", "effect": "deny" },

    // 2.x only. "edit" governs the write, edit and patch tools alike. These keep them away from
    // the Claude Code settings and hooks and from opencode's own config files, global or in a
    // project, any of which could undo the rules above. The last entry leaves .opencode/plan/
    // writable, where the Plan agent saves its plans.
    { "action": "edit", "resource": "*.claude/hooks/*", "effect": "deny" },
    { "action": "edit", "resource": "*.claude/settings.json", "effect": "deny" },
    { "action": "edit", "resource": "*.config/opencode/*", "effect": "deny" },
    { "action": "edit", "resource": "*opencode.json", "effect": "deny" },
    { "action": "edit", "resource": "*opencode.jsonc", "effect": "deny" },
    { "action": "edit", "resource": "*.opencode/*", "effect": "deny" },
    { "action": "edit", "resource": "*.opencode/plan/*", "effect": "allow" },

    // Code Mode's execute tool runs model-written JavaScript: its fetch sends any request with
    // no permission check, and its opencode.session_move tool moves the session elsewhere. A
    // deny on "*" withdraws the tool and every Code Mode tool, MCP ones included; set
    // "codemode": false on an MCP server whose tools must stay available.
    { "action": "execute", "resource": "*", "effect": "deny" }
  ]
}
