# Copy to ~/.codex/rules/openqa-credentials.rules: a regular file, not a symlink, and not
# default.rules, which Codex appends approvals to. Replace /home/USER: rules expand neither ~
# nor $HOME. A rule matches an exact argv prefix; a list is a set of alternatives, and an
# absolute program path also matches by basename. A `bash -lc` script is split only when it is
# plain words, so ~, $VAR, redirects, $(...) and globs go unmatched: config.toml covers those.
# A parse error or a failing match example in ANY rules file disables all of them; after every
# edit run: codex execpolicy check --rules <file> <argv...>
HOME = "/home/USER"

CRED_FILES = [
    HOME + "/.config/openqa/client.conf",
    "/etc/openqa/client.conf",
    "/usr/etc/openqa/client.conf",
    HOME + "/.config/gh/hosts.yml",
    HOME + "/.config/osc/oscrc",
    HOME + "/.oscrc",
    HOME + "/.config/tea/config.yml",
    HOME + "/.netrc",
    HOME + "/.git-credentials",
]
HTTP_DEBUG = [s[:n] for s in ["--http-debug", "--http-full-debug"] for n in range(8, len(s) + 1)]
DUMP_FULL = ["--dump-full"[:n] for n in range(7, 12)]
READERS = ["cat", "less", "more", "head", "tail", "bat", "nl", "tac", "strings",
           "xxd", "od", "hexdump", "base64", "cp", "scp", "rsync", "vi", "vim", "view", "nano"]

prefix_rule(
    pattern = [READERS, CRED_FILES],
    decision = "forbidden",
    justification = "credential file: the tool that owns it reads it itself",
    match = [["cat", HOME + "/.netrc"], ["head", "/etc/openqa/client.conf"]],
    not_match = [["cat", "-n", HOME + "/.netrc"]],
)
prefix_rule(pattern = ["gh", "auth", "token"], decision = "forbidden",
            justification = "prints the gh token")
prefix_rule(pattern = ["gh", "auth", "status"], decision = "forbidden",
            justification = "prints the gh token with -t, -at or --show-token")
prefix_rule(pattern = ["openqa-cli", ["api", "archive", "monitor", "schedule"], ["--apikey", "--apisecret"]],
            decision = "forbidden", justification = "openQA key on the command line; openqa-cli reads client.conf itself")
prefix_rule(pattern = ["env", ["MOJO_CLIENT_DEBUG=1", "MOJO_CLIENT_DEBUG=true"]], decision = "forbidden",
            justification = "prints request headers, the openQA API key among them")
prefix_rule(pattern = ["gh", "auth", "git-credential"], decision = "forbidden",
            justification = "prints the gh token as a git credential")
# Tools that print their own secrets; osc takes any unambiguous prefix of a long option.
prefix_rule(pattern = ["git", "credential", "fill"], decision = "forbidden",
            justification = "prints stored git credentials")
prefix_rule(pattern = [["git-credential-libsecret", "git-credential-store", "git-credential-cache",
                        "git-credential-oauth", "git-credential-keepassxc"], "get"],
            decision = "forbidden", justification = "prints stored git credentials")
prefix_rule(pattern = ["osc", "config", DUMP_FULL], decision = "forbidden",
            justification = "prints osc's credentials")
prefix_rule(pattern = ["osc", ["-H", "-qH", "-vH"] + HTTP_DEBUG], decision = "forbidden",
            justification = "prints request headers, credentials among them")
prefix_rule(pattern = ["osc", "token"], decision = "forbidden",
            justification = "lists or creates OBS tokens with their secrets")
prefix_rule(pattern = ["tea", ["login", "logins"], ["helper", "git-credential", "edit", "e"]],
            decision = "forbidden", justification = "prints tea's token")
prefix_rule(pattern = ["git-obs", "login", ["list", "gitcredentials-helper"]], decision = "forbidden",
            justification = "prints git-obs tokens")
prefix_rule(pattern = ["git", "obs", "login", ["list", "gitcredentials-helper"]], decision = "forbidden",
            justification = "prints git-obs tokens")
