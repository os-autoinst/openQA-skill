+	menuentry 'openSUSE Leap 16.0, with Linux 6.12.0-160000.38-default (recovery mode)' --hotkey=3 --class opensuse --class gnu-linux --class gnu --class os $menuentry_id_option 'gnulinux-6.12.0-160000.38-default-recovery-91fdbf9c-2240-4a82-9c52-40c6289c6cdb' {
