{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "/etc/opencode/CONTAINER.md"
  ],
  "mcp": {
    "servers": {
      "bugzilla": {
        "type": "local",
        "command": [
          "bugwarden",
          "--transport",
          "stdio",
          "--bugzilla-server",
          "https://bugzilla.suse.com",
          "--api-key-file",
          "/agent-logins/bugzilla/api-key",
          "--policy",
          "/etc/bugwarden/policy.toml"
        ],
        "codemode": false
      },
      "memory": {
        "type": "local",
        "command": [
          "mcp-server-memory"
        ],
        "codemode": false
      },
      "sequentialthinking": {
        "type": "local",
        "command": [
          "mcp-server-sequential-thinking"
        ],
        "codemode": false
      }
    }
  },
